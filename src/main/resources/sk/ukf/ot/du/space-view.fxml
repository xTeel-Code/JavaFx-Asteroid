<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.Pane?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="sk.ukf.ot.du.SpaceController">
    <top>
        <FlowPane hgap="10" vgap="10" style="-fx-background-color: #20232a;">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <Button text="Pridať planétu" onAction="#onAddPlanet"/>
            <Button text="Pridať asteroid" onAction="#onAddAsteroid"/>
            <Button text="Pridať satelit" onAction="#onAddSatellite"/>
            <Separator orientation="VERTICAL"/>
            <Button text="Asteroidy na červeno" onAction="#onAsteroidsRed"/>
            <Button text="Satelity o 20 px doprava" onAction="#onSatellitesRight"/>
        </FlowPane>
    </top>
    <center>
        <Pane fx:id="spacePane" style="-fx-background-color: #05070f;"/>
    </center>
</BorderPane>
